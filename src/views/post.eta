<!doctype html>
<html lang="<%= it.htmlLang %>" style="--sp: <%= it.accentColor %>;">
  <head>
    <%~ include("partials/head", { title: it.title, canonical: it.canonical, alternates: it.alternates }) %>
  </head>
  <body>
    <div class="space-shell">
      <div class="space-canto"></div>
      <div>
        <%~ include("partials/space-nav", { spaceName: it.spaceName, centralUrl: it.centralUrl, strings: it.strings, prefix: it.prefix }) %>

        <div class="post-panorama">
          <% if (it.cover) { %>
          <img
            class="post-panorama__photo"
            src="<%= it.cover.src %>"
            srcset="<%= it.cover.srcset %>"
            width="<%= it.cover.width %>"
            height="<%= it.cover.height %>"
            alt=""
            loading="lazy"
          />
          <% } %>
        </div>
        <div class="post-panorama__rule"></div>

        <div class="post-context">
          <div class="post-context__meta">
            <% if (it.category) { %><strong><%= it.category.name %></strong> · <% } %><%= it.date %> ·
            <%= it.readingMinutes %> <%= it.strings.readingMinutesSuffix %>
          </div>
        </div>

        <div class="post-article">
          <div class="post-article__lead">
            <h1><%= it.heading %></h1>
            <% if (it.lead) { %>
            <p class="post-lead"><%= it.lead %></p>
            <% } %>
          </div>

          <div class="post-body"><%~ it.html %></div>

          <% if (it.tags.length > 0) { %>
          <div class="post-tags">
            <% it.tags.forEach(function(tag) { %>
            <span class="tag tag-outline"><%= tag.name %></span>
            <% }) %>
          </div>
          <% } %>

          <% if (it.prev || it.next) { %>
          <div class="post-adjacent">
            <% if (it.prev) { %>
            <a href="<%= it.prefix %>/<%= it.prev.slug %>">← <%= it.prev.title %></a>
            <% } else { %>
            <span></span>
            <% } %> <% if (it.next) { %>
            <a href="<%= it.prefix %>/<%= it.next.slug %>"><%= it.next.title %> →</a>
            <% } %>
          </div>
          <% } %>
        </div>

        <div class="post-footer">
          <span><%= it.postUrl %></span>
          <span><%= it.strings.rssOfSpace %> · <a href="<%= it.centralUrl %>"><%= it.strings.backToAll %></a></span>
        </div>
      </div>
    </div>
  </body>
</html>
