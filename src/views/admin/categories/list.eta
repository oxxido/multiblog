<%~ include("../../partials/admin-head", { title: "Categorías", currentPath: it.currentPath, activeSpaces: it.activeSpaces }) %>
<div class="admin-page-header">
  <div>
    <h1>Categorías</h1>
    <span class="subtitle"><%= it.items.length %> en total</span>
  </div>
  <a class="btn btn-primary" href="/admin/categorias/new">Nueva categoría</a>
</div>
<table class="table">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Espacio</th>
    </tr>
  </thead>
  <tbody>
    <% it.items.forEach(function(item) { %>
    <tr>
      <td><a href="/admin/categorias/<%= item.id %>"><%= item.name %></a></td>
      <td><%= item.spaceName %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%~ include("../../partials/admin-foot") %>

