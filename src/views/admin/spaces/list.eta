<%~ include("../../partials/admin-head", { title: "Espacios", currentPath: it.currentPath, activeSpaces: it.activeSpaces }) %>
<div class="admin-page-header">
  <div>
    <h1>Espacios</h1>
    <span class="subtitle">sin borrado, sólo archivado</span>
  </div>
  <a class="btn btn-primary" href="/admin/espacios/new">Nuevo espacio</a>
</div>
<table class="table">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Subdominio</th>
      <th>Estado</th>
      <th><span class="sr-only">Acciones</span></th>
    </tr>
  </thead>
  <tbody>
    <% it.items.forEach(function(item) { %>
    <tr>
      <td><a href="/admin/espacios/<%= item.id %>"><%= item.name %></a></td>
      <td><%= item.subdomain %></td>
      <td>
        <% if (item.archivedAt) { %>
        <span class="badge badge-draft">Archivado</span>
        <% } else { %>
        <span class="badge badge-published">Activo</span>
        <% } %>
      </td>
      <td>
        <div class="row-actions">
          <a class="btn btn-secondary btn-sm" href="/admin/espacios/<%= item.id %>">Editar</a>
          <% if (!item.archivedAt) { %>
          <form
            method="post"
            action="/admin/espacios/<%= item.id %>/archive"
            onsubmit="return confirm('¿Archivar este espacio? Deja de responder en su subdominio.')"
          >
            <button class="btn btn-danger btn-sm" type="submit">Archivar</button>
          </form>
          <% } %>
        </div>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%~ include("../../partials/admin-foot") %>

