<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Editar post · Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body>
    <header>
      <a href="/admin/posts">← Posts</a>
      <span>
        Estado:
        <% if (it.post.status === "draft") { %> Borrador <% } else if (it.post.status === "scheduled") { %>
        Programado para <%= it.post.publishedAt.toISOString() %> <% } else { %> Publicado <% } %>
      </span>
      <span>Idioma: <%= it.post.lang %></span>
    </header>
    <main>
      <p>
        Vista previa: <a href="<%= it.previewUrl %>"><%= it.previewUrl %></a>
        <form method="post" action="/admin/posts/<%= it.post.id %>/rotate-preview-token" style="display: inline">
          <button type="submit">Rotar link</button>
        </form>
      </p>
      <p><a href="/admin/posts/<%= it.post.id %>/revisions">Ver historial</a></p>
      <% if (it.translateError) { %>
      <p><%= it.translateError %></p>
      <% } %> <% if (it.sibling) { %>
      <p>
        Hermano (<%= it.sibling.lang %>, <%= it.sibling.status %>):
        <a href="/admin/posts/<%= it.sibling.id %>">ver</a>
        <% if (it.siblingIsStale) { %> — traducción desactualizada, el original cambió después de traducirse <% } %>
      </p>
      <% } %>
      <form method="post" action="<%= it.action %>" data-post-id="<%= it.post.id %>">
        <label>
          Espacio
          <select name="spaceId" required>
            <% it.spaceOptions.forEach(function(space) { %>
            <option value="<%= space.id %>" <%= it.post.spaceId === space.id ? "selected" : "" %>>
              <%= space.name %>
            </option>
            <% }) %>
          </select>
        </label>
        <label>
          Slug
          <input type="text" name="slug" required value="<%= it.post.slug %>" />
        </label>
        <label>
          Título
          <input type="text" name="title" required value="<%= it.post.title %>" />
        </label>
        <label>
          Extracto
          <input type="text" name="excerpt" value="<%= it.post.excerpt ? it.post.excerpt : "" %>" />
        </label>
        <%~ include("../../partials/cover-field", { cover: it.cover, value: it.post.coverMediaId }) %>
        <div>
          <button type="button" data-editor-toggle>Ver Markdown</button>
          <button type="button" data-insert-block="image">Imagen</button>
          <button type="button" data-insert-block="callout">Callout</button>
          <button type="button" data-insert-block="gallery">Galería</button>
          <button type="button" data-insert-block="youtube">YouTube</button>
        </div>
        <div id="editor-visual" data-initial-doc="<%= JSON.stringify(it.initialDoc) %>"></div>
        <label>
          Markdown
          <textarea name="bodyMd" rows="20" required><%= it.post.bodyMd %></textarea>
        </label>
        <fieldset>
          <legend>Categorías</legend>
          <% it.categoryOptions.forEach(function(category) { %>
          <label>
            <input
              type="checkbox"
              name="categoryIds"
              value="<%= category.id %>"
              <%= it.post.categoryIds.includes(category.id) ? "checked" : "" %>
            />
            <%= category.name %> (<%= category.spaceName %>)
          </label>
          <% }) %>
        </fieldset>
        <label>
          Tags (separados por coma)
          <input type="text" name="tags" value="<%= it.post.tagNames.join(", ") %>" />
        </label>
        <button type="submit">Guardar</button>
      </form>

      <form method="post" action="/admin/posts/<%= it.post.id %>/publish">
        <button type="submit">Publicar</button>
      </form>
      <form method="post" action="/admin/posts/<%= it.post.id %>/schedule">
        <label>
          Programar para
          <input type="datetime-local" name="publishAt" required />
        </label>
        <button type="submit">Programar</button>
      </form>
      <% if (it.post.status === "scheduled") { %>
      <p>Programado para <%= it.post.publishedAt.toISOString() %></p>
      <form method="post" action="/admin/posts/<%= it.post.id %>/cancel-schedule">
        <button type="submit">Cancelar programación</button>
      </form>
      <% } %> <% if (it.post.lang === "es" && it.post.status === "published") { %>
      <form method="post" action="/admin/posts/<%= it.post.id %>/translate">
        <button type="submit">Traducir al inglés</button>
      </form>
      <% } %>
      <form method="post" action="/admin/posts/<%= it.post.id %>/delete">
        <button type="submit">Borrar</button>
      </form>
    </main>
    <script type="module" src="/admin/static/editor.js"></script>
    <script type="module" src="/admin/static/coverPicker.js"></script>
  </body>
</html>
