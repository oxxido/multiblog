<%~ include("../../partials/admin-head", { title: it.post.title, currentPath: it.currentPath, activeSpaces: it.activeSpaces }) %>
<div class="editor-topbar" style="--space-accent: <%= it.space.accentColor || "#5980a6" %>">
  <div class="cluster">
    <a class="back" href="/admin/posts">← Posts</a>
    <span class="divider">|</span>
    <% if (it.post.status === "draft") { %>
    <span class="badge badge-draft">Borrador</span>
    <% } else if (it.post.status === "scheduled") { %>
    <span class="badge badge-scheduled">Programado para <%= it.formatDateTime(it.post.publishedAt) %></span>
    <% } else { %>
    <span class="badge badge-published">Publicado</span>
    <% } %>
    <span class="text-muted">Idioma: <%= it.post.lang.toUpperCase() %></span>
    <% if (it.sibling) { %>
    <a class="btn-ghost" href="/admin/posts/<%= it.sibling.id %>">Ver post hermano (<%= it.sibling.lang.toUpperCase() %>)</a>
    <% } %>
  </div>
  <div class="cluster">
    <a class="btn-ghost" href="<%= it.previewUrl %>" target="_blank" rel="noopener">Vista previa</a>
    <form method="post" action="/admin/posts/<%= it.post.id %>/rotate-preview-token">
      <button class="btn btn-secondary" type="submit">Rotar token</button>
    </form>
    <a class="btn-ghost" href="/admin/posts/<%= it.post.id %>/revisions">Historial</a>
  </div>
</div>

<% if (it.translateError) { %>
<div class="banner banner-error"><span><%= it.translateError %></span></div>
<% } %> <% if (it.sibling && it.siblingIsStale) { %>
<div class="banner banner-warning">
  <span><strong>Traducción desactualizada.</strong> El post en <%= it.post.lang.toUpperCase() %> cambió después de la última traducción.</span>
  <a class="btn-ghost" href="/admin/posts/<%= it.post.id %>/revisions">Ver diferencias</a>
</div>
<% } %>

<div class="editor-grid">
  <div class="editor-main">
    <form id="post-form" method="post" action="<%= it.action %>" data-post-id="<%= it.post.id %>">
      <label class="field">
        <span class="kicker">Espacio</span>
        <select class="input" name="spaceId" required>
          <% it.spaceOptions.forEach(function(space) { %>
          <option value="<%= space.id %>" <%= it.post.spaceId === space.id ? "selected" : "" %>><%= space.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span class="kicker">Slug</span>
        <input class="input" type="text" name="slug" required value="<%= it.post.slug %>" />
        <span class="field-help"><%= it.space.subdomain %>.<%= it.baseDomain %>/<%= it.post.slug %></span>
      </label>
      <label class="field">
        <span class="kicker">Título</span>
        <input class="input" type="text" name="title" required value="<%= it.post.title %>" />
      </label>
      <label class="field">
        <span class="kicker">Extracto</span>
        <textarea class="input" name="excerpt" rows="2"><%= it.post.excerpt ? it.post.excerpt : "" %></textarea>
      </label>

      <div class="banner banner-error banner-sticky" data-editor-error role="alert" hidden><span data-editor-error-text></span></div>
      <div class="banner banner-success banner-sticky" data-editor-notice role="status" hidden><span data-editor-notice-text></span></div>
      <div class="banner banner-warning banner-sticky" data-editor-restore hidden>
        <span data-editor-restore-text></span>
        <span class="cluster">
          <button type="button" class="btn btn-secondary" data-restore-apply>Restaurar</button>
          <button type="button" class="btn-ghost" data-restore-discard>Descartar</button>
        </span>
      </div>
      <div
        class="ai-assist"
        data-ai-assist
        data-prompt-improve="<%= it.assistPrompts.improve %>"
        data-prompt-review="<%= it.assistPrompts.review %>"
      >
        <div class="ai-assist__actions">
          <button type="button" class="insert-block" data-ai-open="improve">
            <svg class="ai-assist__star" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2l2.9 6.6 7.1.7-5.4 4.8 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.3l7.1-.7z" /></svg>
            Mejorar post
          </button>
          <button type="button" class="insert-block" data-ai-open="review">Revisar este texto</button>
        </div>
        <section class="ai-panel" data-ai-panel hidden>
          <div class="ai-panel__head">
            <span class="kicker" data-ai-title></span>
            <button type="button" class="btn-ghost" data-ai-close>Cerrar</button>
          </div>
          <textarea class="input" rows="4" data-ai-prompt aria-label="Prompt"></textarea>
          <div class="ai-panel__run">
            <button type="button" class="btn btn-primary" data-ai-run></button>
            <span class="ai-panel__status" data-ai-status role="status"></span>
          </div>
          <div class="ai-panel__result" data-ai-result hidden>
            <span class="kicker">Resultado</span>
            <textarea class="input" rows="18" readonly data-ai-output aria-label="Resultado"></textarea>
            <div class="ai-panel__run">
              <button type="button" class="btn btn-secondary" data-ai-replace>Reemplazar texto</button>
              <button type="button" class="btn-ghost" data-ai-undo hidden>Deshacer reemplazo</button>
            </div>
          </div>
        </section>
      </div>

      <div class="editor-toolbar">
        <button type="button" class="seg-toggle" data-editor-toggle data-mode="visual">
          <span class="opt opt-visual">Visual</span><span class="opt opt-raw">Markdown</span>
        </button>
        <span class="divider">|</span>
        <div class="format-group" role="group" aria-label="Formato">
          <button type="button" class="insert-block" data-format="bold" title="Negrita" aria-label="Negrita"><strong>B</strong></button>
          <button type="button" class="insert-block" data-format="italic" title="Cursiva" aria-label="Cursiva"><em>I</em></button>
          <button type="button" class="insert-block" data-format="code" title="Código en línea" aria-label="Código en línea">&lt;/&gt;</button>
          <button type="button" class="insert-block" data-format="link" title="Enlace" aria-label="Enlace">Enlace</button>
          <button type="button" class="insert-block" data-format="h2" title="Título" aria-label="Título">H2</button>
          <button type="button" class="insert-block" data-format="h3" title="Subtítulo" aria-label="Subtítulo">H3</button>
          <button type="button" class="insert-block" data-format="bulletList" title="Lista" aria-label="Lista">• Lista</button>
          <button type="button" class="insert-block" data-format="orderedList" title="Lista numerada" aria-label="Lista numerada">1. Lista</button>
          <button type="button" class="insert-block" data-format="blockquote" title="Cita" aria-label="Cita">Cita</button>
          <button type="button" class="insert-block" data-format="codeBlock" title="Bloque de código" aria-label="Bloque de código">Código</button>
        </div>
        <span class="divider">|</span>
        <button type="button" class="insert-block" data-insert-block="image">Imagen</button>
        <button type="button" class="insert-block" data-insert-block="callout">Callout</button>
        <button type="button" class="insert-block" data-insert-block="gallery">Galería</button>
        <button type="button" class="insert-block" data-insert-block="youtube">YouTube</button>
      </div>
      <div class="media-panel" data-editor-media-panel hidden></div>
      <div id="editor-visual" data-initial-doc="<%= JSON.stringify(it.initialDoc) %>"></div>
      <label class="field">
        <span class="kicker">Markdown</span>
        <textarea name="bodyMd" class="input" rows="20"><%= it.post.bodyMd %></textarea>
        <span class="field-help">Sincronizado con el editor visual en cada cambio.</span>
      </label>
    </form>
  </div>

  <aside class="editor-sidebar">
    <div class="card">
      <span class="kicker">Publicación</span>
      <button class="btn btn-primary btn-block" type="submit" form="post-form" data-save-button>Guardar</button>
      <p class="field-help" data-save-status role="status"></p>
    </div>

    <div class="card">
      <form method="post" action="/admin/posts/<%= it.post.id %>/publish" data-action-form data-busy-label="Publicando…">
        <input type="hidden" name="back" value="public" />
        <button class="btn btn-secondary btn-block" type="submit">Publicar ahora</button>
      </form>
      <% if (it.post.status === "published") { %>
      <form method="post" action="/admin/posts/<%= it.post.id %>/unpublish" data-action-form data-busy-label="Despublicando…">
        <button class="btn-ghost" type="submit">Despublicar</button>
      </form>
      <% } %>
      <hr class="hr" />
      <span class="kicker">Programar</span>
      <form method="post" action="/admin/posts/<%= it.post.id %>/schedule" data-action-form data-busy-label="Programando…">
        <input class="input" type="datetime-local" name="publishAt" required />
        <div class="schedule-actions">
          <button class="btn btn-secondary" type="submit">Programar</button>
        </div>
      </form>
      <% if (it.post.status === "scheduled") { %>
      <p class="field-help">Programado para <%= it.formatDateTime(it.post.publishedAt) %></p>
      <form method="post" action="/admin/posts/<%= it.post.id %>/cancel-schedule">
        <button class="btn-ghost" type="submit">Cancelar programación</button>
      </form>
      <% } %>
    </div>

    <div class="card">
      <span class="kicker">Portada</span>
      <%~ include("../../partials/cover-field", { cover: it.cover, value: it.post.coverMediaId, formId: "post-form" }) %>
    </div>

    <div class="card">
      <span class="kicker">Categorías</span>
      <div class="checklist">
        <% it.categoryOptions.forEach(function(category) { %>
        <label>
          <input
            type="checkbox"
            name="categoryIds"
            value="<%= category.id %>"
            form="post-form"
            <%= it.post.categoryIds.includes(category.id) ? "checked" : "" %>
          />
          <%= category.name %> <span class="text-muted">(<%= category.spaceName %>)</span>
        </label>
        <% }) %>
      </div>
    </div>

    <div class="card">
      <span class="kicker">Tags</span>
      <input class="input" type="text" name="tags" form="post-form" value="<%= it.post.tagNames.join(", ") %>" />
      <span class="field-help">Separados por coma. No hay gestión aparte.</span>
    </div>

    <% if (it.post.lang === "es" && it.post.status === "published") { %>
    <div class="card">
      <form method="post" action="/admin/posts/<%= it.post.id %>/translate" data-action-form data-busy-label="Traduciendo…">
        <button class="btn btn-secondary btn-block" type="submit">Traducir al inglés</button>
        <p class="field-help" data-busy-hint hidden>Puede tardar un minuto. No cierres la página.</p>
      </form>
    </div>
    <% } %>

    <div class="card">
      <form method="post" action="/admin/posts/<%= it.post.id %>/delete">
        <button class="btn-ghost" style="color: var(--color-error-text)" type="submit">Borrar post</button>
      </form>
    </div>
  </aside>
</div>
<%~ include("../../partials/admin-foot", { scripts: ["/admin/static/editor.js", "/admin/static/coverPicker.js"] }) %>
