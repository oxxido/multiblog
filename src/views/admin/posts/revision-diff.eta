<%~ include("../../partials/admin-head", { title: "Diff · " + it.post.title, currentPath: it.currentPath, activeSpaces: it.activeSpaces }) %>
<a class="btn-ghost" href="/admin/posts/<%= it.post.id %>/revisions">← Historial</a>
<div class="admin-page-header">
  <div>
    <h1>Diff contra la revisión anterior</h1>
    <span class="subtitle"><%= it.revision.createdAt.toISOString() %></span>
  </div>
</div>
<% if (it.diffHtml === null) { %>
<p class="text-muted">Esta es la primera revisión guardada de este post: no hay una anterior contra la que compararla.</p>
<% } else { %>
<div class="diff"><pre><%~ it.diffHtml %></pre></div>
<% } %>
<%~ include("../../partials/admin-foot") %>

