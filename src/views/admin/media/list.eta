<%~ include("../../partials/admin-head", { title: "Medios", currentPath: it.currentPath, activeSpaces: it.activeSpaces }) %>
<div class="admin-page-header">
  <div>
    <h1>Medios</h1>
    <span class="subtitle"><%= it.items.length %> imágenes · máximo 15 MB por archivo</span>
  </div>
</div>
<form class="field" method="post" action="/admin/media" enctype="multipart/form-data">
  <label class="field">
    <span class="kicker">Subir imagen (JPEG, PNG o WebP, máximo 15 MB)</span>
    <input class="input" type="file" name="file" accept="image/jpeg,image/png,image/webp" required />
  </label>
  <button class="btn btn-primary" type="submit">Subir</button>
</form>

<div class="picker-grid">
  <% it.items.forEach(function(item) { %>
  <div class="picker-item blueprint">
    <i class="corner tl"></i>
    <i class="corner tr"></i>
    <i class="corner bl"></i>
    <i class="corner br"></i>
    <div class="thumb"><img src="<%= item.thumbnail %>" alt="" /></div>
    <div class="filename"><%= item.filename %></div>
    <div class="filename"><%= item.width %>×<%= item.height %> · <%= Math.round(item.size / 1024) %> KB</div>
    <a class="btn-ghost" href="/admin/media/<%= item.id %>/delete">Borrar</a>
  </div>
  <% }) %>
</div>
<%~ include("../../partials/admin-foot") %>

