<%~ include("../../partials/admin-head", { title: "Borrar imagen", currentPath: it.currentPath, activeSpaces: it.activeSpaces }) %>
<a class="btn-ghost" href="/admin/media">← Medios</a>
<div class="admin-page-header">
  <h1>Borrar imagen</h1>
</div>
<div class="cover-preview blueprint" style="max-width: 320px">
  <i class="corner tl"></i>
  <i class="corner tr"></i>
  <i class="corner bl"></i>
  <i class="corner br"></i>
  <img src="<%= it.item.thumbnail %>" alt="" />
</div>
<p><%= it.item.filename %></p>

<% if (it.usages.length > 0) { %>
<p>Esta imagen está en uso en:</p>
<ul>
  <% it.usages.forEach(function(usage) { %>
  <li><%= usage.label %></li>
  <% }) %>
</ul>
<p class="text-muted">
  Borrarla saca la foto de esos lugares (vuelven a "sin foto"); una imagen embebida en el cuerpo de un post queda
  rota.
</p>
<% } else { %>
<p class="text-muted">Esta imagen no está en uso en ningún post, espacio ni en el sitio.</p>
<% } %>

<form method="post" action="/admin/media/<%= it.item.id %>/delete">
  <button class="btn btn-danger" type="submit">Confirmar borrado</button>
</form>
<%~ include("../../partials/admin-foot") %>

