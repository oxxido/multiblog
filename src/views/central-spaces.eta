<!doctype html>
<html lang="<%= it.htmlLang %>">
  <head>
    <%~ include("partials/head", {
      title: it.title,
      canonical: it.canonical,
      ogType: it.ogType,
      ogTitle: it.ogTitle,
      ogImage: it.ogImage,
    }) %>
  </head>
  <body>
    <div class="central">
      <div class="central-hero<% if (it.cover) { %> has-cover<% } %>">
        <% if (it.cover) { %>
        <img
          class="central-hero__photo"
          src="<%= it.cover.src %>"
          srcset="<%= it.cover.srcset %>"
          width="<%= it.cover.width %>"
          height="<%= it.cover.height %>"
          alt=""
          loading="lazy"
        />
        <% } %>
        <div class="central-hero__nav">
          <div class="central-hero__brand"><%= it.brand %></div>
          <div class="central-hero__links">
            <a href="<%= it.prefix %>/espacios"><%= it.strings.spacesNavLabel %></a>
            <a href="<%= it.prefix %>/#tags"><%= it.strings.tagsNavLabel %></a>
            <a href="<%= it.prefix %>/feed.xml"><%= it.strings.rssNavLabel %></a>
          </div>
        </div>
        <div>
          <h1><%= it.heading %></h1>
        </div>
      </div>

      <div class="central-section">
        <%~ include("partials/space-grid", { spaces: it.spaces }) %>
      </div>

      <div class="central-footer">
        <span><%= it.brand %></span>
        <span><a href="<%= it.prefix %>/feed.xml"><%= it.strings.rssAggregatedLabel %></a> · <%= it.strings.archiveLabel %></span>
      </div>
    </div>
  </body>
</html>
