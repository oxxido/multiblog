<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= it.title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500&family=Barlow+Condensed:wght@400;500;600&family=Literata:ital,wght@0,400;0,600;1,400&display=swap"
  rel="stylesheet"
/>
<link rel="stylesheet" href="/css/site.css" />
<% if (it.canonical) { %>
<link rel="canonical" href="<%= it.canonical %>" />
<% } %> <% if (it.alternates) { %> <% it.alternates.forEach(function(alternate) { %>
<link rel="alternate" hreflang="<%= alternate.hreflang %>" href="<%= alternate.href %>" />
<% }) %> <% } %> <% if (it.ogType) { %>
<meta property="og:type" content="<%= it.ogType %>" />
<meta property="og:title" content="<%= it.ogTitle %>" />
<% if (it.ogDescription) { %>
<meta property="og:description" content="<%= it.ogDescription %>" />
<% } %> <% if (it.canonical) { %>
<meta property="og:url" content="<%= it.canonical %>" />
<% } %> <% if (it.ogImage) { %>
<meta property="og:image" content="<%= it.ogImage %>" />
<% } %> <% } %>
