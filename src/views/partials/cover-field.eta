<div data-cover-field class="cover-field">
  <div class="cover-preview blueprint">
    <i class="corner tl"></i>
    <i class="corner tr"></i>
    <i class="corner bl"></i>
    <i class="corner br"></i>
    <img data-cover-preview src="<%= it.cover ? it.cover.src : "" %>" alt="" <%= it.cover ? "" : "hidden" %> />
  </div>
  <input
    type="hidden"
    name="coverMediaId"
    data-cover-input
    value="<%= it.value ? it.value : "" %>"
    <%= it.formId ? `form="${it.formId}"` : "" %>
  />
  <div class="actions">
    <button type="button" class="btn btn-secondary" data-cover-picker>Cambiar</button>
  </div>
</div>
