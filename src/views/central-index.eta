<!doctype html>
<html lang="<%= it.htmlLang %>">
  <head>
    <%~ include("partials/head", { title: it.title }) %>
  </head>
  <body>
    <div class="central">
      <div class="central-hero<% if (it.cover) { %> has-cover<% } %>">
        <% if (it.cover) { %>
        <img
          class="central-hero__photo"
          src="<%= it.cover.src %>"
          srcset="<%= it.cover.srcset %>"
          width="<%= it.cover.width %>"
          height="<%= it.cover.height %>"
          alt=""
          loading="lazy"
        />
        <% } %>
        <div class="central-hero__nav">
          <div class="central-hero__brand"><%= it.brand %></div>
          <div class="central-hero__links">
            <a href="#espacios"><%= it.strings.spacesNavLabel %></a>
            <a href="#tags"><%= it.strings.tagsNavLabel %></a>
            <span><%= it.strings.rssNavLabel %></span>
          </div>
        </div>
        <div>
          <h1><%~ it.strings.centralHeadline %></h1>
          <% if (it.spaceNames) { %>
          <p class="central-hero__lead"><%= it.spaceNames %>. <%= it.strings.centralLeadSuffix %></p>
          <% } %>
        </div>
      </div>

      <div class="central-section" id="espacios">
        <div class="central-section__header">
          <div class="central-section__title"><%= it.strings.spacesNavLabel %></div>
          <div class="central-section__count">
            <%= it.activeCount %> <%= it.strings.activeCountLabel %> · <%= it.totalPublished %>
            <%= it.strings.publishedCountLabel %>
          </div>
        </div>
        <div class="space-grid">
          <% it.spaces.forEach(function(space) { %>
          <a href="<%= space.url %>" class="blueprint space-card">
            <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
            <div class="space-card__name">
              <span class="space-card__dot" style="background: <%= space.accentColor %>;"></span>
              <span><%= space.name %></span>
            </div>
            <% if (space.description) { %>
            <p class="space-card__desc"><%= space.description %></p>
            <% } %>
            <div class="space-card__meta">
              <span><%= space.subdomain %></span>
              <span><%= space.publishedCount %></span>
            </div>
          </a>
          <% }) %>
        </div>
      </div>

      <div class="central-section">
        <div class="central-section__title" style="margin-bottom: 8px;"><%= it.strings.latestSectionTitle %></div>
        <div class="latest-list">
          <% it.latest.forEach(function(item) { %>
          <a href="<%= item.url %>" class="latest-item">
            <span class="latest-item__dot" style="background: <%= item.accentColor %>;"></span>
            <span>
              <span class="latest-item__title"><%= item.title %></span>
              <% if (item.excerpt) { %>
              <span class="latest-item__excerpt"><%= item.excerpt %></span>
              <% } %>
            </span>
            <span class="latest-item__date"><%= item.date %></span>
          </a>
          <% }) %>
        </div>
      </div>

      <div class="central-section" id="tags">
        <div class="tag-row">
          <div class="tag-row__title"><%= it.strings.crossTagsSectionTitle %></div>
          <div class="tag-row__tags">
            <% it.tags.forEach(function(tag) { %>
            <span class="tag tag-outline"><%= tag.name %> · <%= tag.count %></span>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="central-footer">
        <span><%= it.brand %></span>
        <span><%= it.strings.rssAggregatedLabel %> · <%= it.strings.archiveLabel %></span>
      </div>
    </div>
  </body>
</html>
